[Unit]
Description=Claude Code orchestrator (WhatsApp remote control)
After=whatsapp-bridge.service
Requires=whatsapp-bridge.service

[Service]
Type=simple
WorkingDirectory=%h/PycharmProjects/wasap_grill_me
Environment=LD_LIBRARY_PATH=%h/PycharmProjects/wasap_grill_me/.venv/lib/python3.14/site-packages/nvidia/cublas/lib:%h/PycharmProjects/wasap_grill_me/.venv/lib/python3.14/site-packages/nvidia/cudnn/lib
ExecStart=%h/PycharmProjects/wasap_grill_me/.venv/bin/claude-orchestrator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
