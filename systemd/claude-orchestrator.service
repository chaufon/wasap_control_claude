[Unit]
Description=Claude Code orchestrator (WhatsApp remote control)
After=whatsapp-bridge.service
Requires=whatsapp-bridge.service

[Service]
Type=simple
WorkingDirectory=%h/PycharmProjects/wasap_grill_me
ExecStart=%h/PycharmProjects/wasap_grill_me/.venv/bin/claude-orchestrator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
